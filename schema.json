{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rapport de veille (schéma v1)",
  "description": "Format partagé par Claude, Janus et la PWA. Sert à contraindre la génération, valider avant commit et mesurer la qualité.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "date",
    "period",
    "alert",
    "domains",
    "top_changes",
    "scenarios",
    "impacts",
    "indicators",
    "actions",
    "hypotheses",
    "sources",
    "caveat"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "generator": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "period": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zone": {
          "type": "string"
        },
        "situation": {
          "type": "string"
        },
        "frequence": {
          "type": "string"
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "label",
        "summary",
        "change_reason"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "label": {
          "type": "string",
          "enum": [
            "VERT",
            "JAUNE",
            "ORANGE",
            "ROUGE",
            "NOIR"
          ]
        },
        "summary": {
          "type": "string"
        },
        "change_reason": {
          "type": "string"
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "level",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "geo",
              "energie",
              "supply",
              "cyber",
              "climat",
              "sante",
              "social",
              "prep"
            ]
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "note": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "top_changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "strength",
          "domain",
          "fact",
          "mechanism",
          "effect",
          "sources"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "strength": {
            "type": "string",
            "enum": [
              "fort",
              "faible"
            ]
          },
          "domain": {
            "type": "string"
          },
          "fact": {
            "type": "string",
            "maxLength": 300
          },
          "mechanism": {
            "type": "string",
            "maxLength": 300
          },
          "effect": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "p30",
          "p90",
          "p1y",
          "confidence",
          "trigger",
          "justification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "p30": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "v",
              "lo",
              "hi"
            ],
            "properties": {
              "v": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "lo": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "hi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "p90": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "v",
              "lo",
              "hi"
            ],
            "properties": {
              "v": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "lo": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "hi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "p1y": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "v",
              "lo",
              "hi"
            ],
            "properties": {
              "v": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "lo": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "hi": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "trigger": {
            "type": "string"
          },
          "justification": {
            "type": "string"
          }
        }
      }
    },
    "impacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "eau",
          "alim",
          "energie",
          "sante",
          "mobilite",
          "info",
          "securite"
        ],
        "properties": {
          "scenario_id": {
            "type": "string"
          },
          "eau": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "alim": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "energie": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "sante": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "mobilite": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "info": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "securite": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "indicators": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "current",
          "up",
          "down",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "up": {
            "type": "string"
          },
          "down": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "loin",
              "approche",
              "franchi"
            ]
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "text",
          "status"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "text": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "fait",
              "afaire",
              "interdit"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "urgent",
              "mois",
              "plus_tard"
            ]
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "verdict"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "juste",
              "faux",
              "indetermine",
              "nouveau"
            ]
          },
          "comment": {
            "type": "string"
          },
          "eval_date": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "title"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "caveat": {
      "type": "string"
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "why",
        "metrics",
        "cascade"
      ],
      "description": "Sujet suivi en profondeur (ex. diesel) : indicateurs de quantité et cascade d'effets par étapes.",
      "properties": {
        "title": {
          "type": "string"
        },
        "why": {
          "type": "string",
          "maxLength": 300
        },
        "metrics": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "surveille",
                  "alerte"
                ]
              }
            }
          }
        },
        "cascade": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "delay",
              "label",
              "effect",
              "status"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "pattern": "^C[0-9]$"
              },
              "delay": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "maxLength": 300
              },
              "status": {
                "type": "string",
                "enum": [
                  "en_cours",
                  "surveille",
                  "inactif"
                ]
              }
            }
          }
        },
        "note": {
          "type": "string"
        },
        "domain": {
          "type": "string",
          "enum": [
            "geo",
            "energie",
            "supply",
            "cyber",
            "climat",
            "sante",
            "social",
            "prep"
          ],
          "description": "Domaine d'affichage (facultatif ; sinon rangement par défaut de l'application)."
        }
      }
    },
    "theaters": {
      "type": "array",
      "maxItems": 6,
      "description": "Tour des théâtres géopolitiques, couverts à chaque rapport.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "level",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{2,4}$"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "note": {
            "type": "string",
            "maxLength": 260
          }
        }
      }
    },
    "watch": {
      "type": "array",
      "maxItems": 10,
      "description": "Veille élargie : canaux de risque hors géopolitique, suivis à chaque rapport (ids fixes).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "level",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{2,4}$"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "note": {
            "type": "string",
            "maxLength": 260
          },
          "local": {
            "type": "string",
            "maxLength": 160,
            "description": "Effet concret au Québec, pour la famille."
          },
          "domain": {
            "type": "string",
            "enum": [
              "geo",
              "energie",
              "supply",
              "cyber",
              "climat",
              "sante",
              "social",
              "prep"
            ],
            "description": "Domaine d'affichage (facultatif ; sinon rangement par défaut de l'application)."
          }
        }
      }
    },
    "drills": {
      "type": "array",
      "maxItems": 6,
      "description": "Tests et exercices officiels de la période (alertes, exercices de coupure) et rumeurs associées : ce qui inquiète mais est maîtrisé.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "zone",
          "title",
          "what",
          "verdict"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "what": {
            "type": "string",
            "maxLength": 240
          },
          "rumor": {
            "type": "string",
            "maxLength": 240
          },
          "verdict": {
            "type": "string",
            "enum": [
              "test_officiel",
              "exercice_sur_table",
              "rumeur_infondee",
              "a_confirmer"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "radar": {
      "type": "array",
      "maxItems": 3,
      "description": "Signaux faibles hors périmètre, avec une décision explicite.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "why",
          "decision"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "maxLength": 260
          },
          "decision": {
            "type": "string",
            "enum": [
              "suivre",
              "verifier",
              "ignorer"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "calendar": {
      "type": "array",
      "maxItems": 8,
      "description": "Échéances connues à venir qui peuvent déplacer un risque.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "label"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "label": {
            "type": "string"
          },
          "why": {
            "type": "string",
            "maxLength": 160
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "contradiction": {
      "type": "string",
      "maxLength": 320,
      "description": "Contre-lecture : le fait de la période qui contredit le plus le scénario principal, et ce qu'on en conclut."
    }
  }
}
